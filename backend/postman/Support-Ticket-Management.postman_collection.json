        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cannot export monthly invoice PDF\",\n  \"description\": \"Clicking Export PDF on the billing dashboard returns a 500 error.\",\n  \"category\": \"billing\",\n  \"priority\": \"high\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List Tickets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets?status=open&priority=high&category=billing&search=invoice&sort=-createdAt&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "status", "value": "open" },
                { "key": "priority", "value": "high" },
                { "key": "category", "value": "billing" },
                { "key": "search", "value": "invoice" },
                { "key": "sort", "value": "-createdAt" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "response": []
